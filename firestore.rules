rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function projectPinRegistryIsValid(id) {
      let pinDoc = getAfter(/databases/$(database)/documents/settings/projectPins).data;
      return pinDoc.pinnedIds.size() <= 3
        && ((request.resource.data.pinned == true && id in pinDoc.pinnedIds)
        || (request.resource.data.pinned != true && !(id in pinDoc.pinnedIds)));
    }
    match /posts/{id} { allow read: if resource.data.status == 'published' || resource.data.visibility == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /videos/{id} { allow read: if resource.data.status == 'published' || resource.data.visibility == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /projects/{id} { allow read: if resource.data.visibility == 'published' || resource.data.status == 'published' || isAdmin(); allow create, update: if isAdmin() && projectPinRegistryIsValid(id); allow delete: if isAdmin(); }
    match /notes/{id} { allow read: if resource.data.status == 'published' || resource.data.visibility == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tags/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sections/{id} { allow read: if resource.data.enabled == true || isAdmin(); allow write: if isAdmin(); }
    // Only the intentionally public site profile can be read without an admin claim.
    // Internal settings (including the project pin registry) must never be enumerable publicly.
    match /settings/{id} {
      allow read: if id == 'site' || isAdmin();
      allow write: if isAdmin() && (id != 'projectPins' || request.resource.data.pinnedIds is list && request.resource.data.pinnedIds.size() <= 3);
    }
    match /media/{id} { allow read: if true; allow write: if isAdmin(); }
    match /users/{id} { allow read, write: if isAdmin() && request.auth.uid == id; }
  }
}
